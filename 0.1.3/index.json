    },
    "entries": {
      "type": "array",
      "items": {
        "title": {
          "type": "string",
          "description": "The title of the index entry."
        },
        "description": {
          "type": "string",
          "description": "The description of the index entry."
        },
        "url": {
          "type": "string",
          "description": "The URL to the manifest."
        },
        "color": {
          "type": "string",
          "description": "The color (in HTML hex format) of the index entry."
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "name",
                "homepage"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "homepage": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "The author of the index entry."
        }
      }
    }
  },
  "$id": "https://schema.doxl.ch/0.1.3/index.json",
  "title": "Index",
